{
  "name": "idle-hero",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based idle RPG prototype built with React, TypeScript, Vite, and Three.js.",
  "type": "module",
  "keywords": [
    "idle-game",
    "rpg",
    "react",
    "typescript",
    "threejs",
    "vite"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
